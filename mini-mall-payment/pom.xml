<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承根 pom: 拿 Spring Boot 3.3.5 + SC/SCA + Nacos + Sentinel 版本管理 -->
    <parent>
        <groupId>com.minimall</groupId>
        <artifactId>mini-mall-cloud</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mini-mall-payment</artifactId>
    <name>mini-mall-payment</name>
    <description>支付服务: 支付宝沙箱, 支付单/退款单/异步回调验签+幂等</description>

    <dependencies>

        <!-- ① common-core: Result / BusinessException / GlobalExceptionHandler
                (Feign starter 也在 common-core 里传递过来, 不用单独引) -->
        <dependency>
            <groupId>com.minimall</groupId>
            <artifactId>mini-mall-common-core</artifactId>
        </dependency>

        <!-- ② common-security: 从 X-User-Id 头塞 SecurityContextHolder,
                /pay/create 是用户发起的, 要拿当前 userId -->
        <dependency>
            <groupId>com.minimall</groupId>
            <artifactId>mini-mall-common-security</artifactId>
        </dependency>

        <!-- ③ 公共 Swagger / Knife4j -->
        <dependency>
            <groupId>com.minimall</groupId>
            <artifactId>mini-mall-common-swagger</artifactId>
        </dependency>

        <!-- ④ Spring Web: 写 @RestController -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ⑤ MyBatis-Plus: payment / refund / payment_notify_log 三张表的 CRUD -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MP 3.5.9+ 分页插件依赖 jsqlparser, 不加分页不生效 (order 服务踩过这个坑) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- ⑥ MySQL 驱动 (连 mini_mall_payment 库), runtime 作用域 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ⑦ ⭐ 支付宝 SDK (核心)
                版本 3.7.73.ALL: 本机 .m2 已缓存, 离线可编译。
                根 pom 没管理 alipay, 所以这里【必须写版本号】。 -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>3.7.73.ALL</version>
        </dependency>

        <!-- ⑧ Sentinel 规则持久化到 Nacos (跟其它业务服务一致) -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <!-- ⑨ Lombok (common-core 里 optional 不传递, 每个模块自己声明) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!-- 显式声明 spring-boot-maven-plugin 才能打 fat jar (一条 java -jar 就能跑) -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
