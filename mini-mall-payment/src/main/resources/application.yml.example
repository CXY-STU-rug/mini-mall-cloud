server:
  port: 9008

spring:
  application:
    name: mini-mall-payment

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${PAYMENT_DB_URL:jdbc:mysql://localhost:3306/mini_mall_payment?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true}
    username: ${PAYMENT_DB_USERNAME:root}
    password: ${PAYMENT_DB_PASSWORD:YOUR_DB_PASSWORD}

  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_ADDR:127.0.0.1:8848}

    sentinel:
      transport:
        dashboard: ${SENTINEL_DASHBOARD:127.0.0.1:8858}
        port: ${SENTINEL_PAYMENT_PORT:8725}
      eager: true

feign:
  sentinel:
    enabled: true

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto

alipay:
  # 支付宝沙箱/正式应用信息必须通过环境变量注入，不要写进仓库。
  app-id: ${ALIPAY_APP_ID:YOUR_ALIPAY_APP_ID}
  private-key: ${ALIPAY_PRIVATE_KEY:YOUR_ALIPAY_APP_PRIVATE_KEY}
  alipay-public-key: ${ALIPAY_PUBLIC_KEY:YOUR_ALIPAY_PUBLIC_KEY}
  gateway-url: ${ALIPAY_GATEWAY_URL:https://openapi-sandbox.dl.alipaydev.com/gateway.do}

  # 支付宝异步回调必须是公网可访问地址；本地联调可用内网穿透临时域名。
  notify-url: ${ALIPAY_NOTIFY_URL:https://your-public-domain.example.com/pay/notify}
  refund-notify-url: ${ALIPAY_REFUND_NOTIFY_URL:https://your-public-domain.example.com/refund/notify}

  # 同步跳回只用于页面展示，订单最终状态必须以异步回调/主动查询为准。
  return-url: ${ALIPAY_RETURN_URL:http://localhost:5174/pay/result}
  sign-type: RSA2
  charset: utf-8
  format: json

logging:
  level:
    com.minimall: debug
    root: info
