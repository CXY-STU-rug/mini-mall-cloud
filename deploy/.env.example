# ============================================================
# 环境变量样板 —— 复制成 .env 再填真实值
#   cp .env.example .env
# ★ .env 里是真密钥，绝对不能进 git！(deploy/.gitignore 已忽略 .env)
#   compose 用 --env-file .env 读取，注入到各容器
# ============================================================

# ── 中间件账号密码 ──
MYSQL_ROOT_PASS=改成强密码
RABBITMQ_USER=admin
RABBITMQ_PASS=改成强密码
MINIO_USER=minioadmin
MINIO_PASS=改成强密码

# ── 支付宝(生产要换正式应用的，别用沙箱) ──
ALIPAY_APP_ID=你的appid
ALIPAY_PRIVATE_KEY=应用私钥一整行PKCS8不带BEGIN/END
ALIPAY_PUBLIC_KEY=支付宝公钥一整行
ALIPAY_NOTIFY_URL=https://你的域名/pay/notify
ALIPAY_REFUND_NOTIFY_URL=https://你的域名/refund/notify

# ── 邮箱验证码登录(QQ邮箱授权码) ──
MAIL_AUTH_CODE=你的邮箱授权码

# ── AI ──
DEEPSEEK_API_KEY=你的deepseek_key（跑通后记得重置）
