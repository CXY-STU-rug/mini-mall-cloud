server:
  port: 9080

spring:
  application:
    name: mini-mall-gateway

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      database: ${REDIS_DATABASE:0}
      timeout: 3000ms

  cloud:
    nacos:
      discovery:
        server-addr: ${NACOS_ADDR:127.0.0.1:8848}

    sentinel:
      transport:
        dashboard: ${SENTINEL_DASHBOARD:127.0.0.1:8858}
        port: ${SENTINEL_PORT:8721}
      eager: true
      # G4: 过滤器挪到鉴权后, 避免限流 cancel 与 401 提交的订阅竞态(裸200空响应)
      filter:
        order: 0
      # G4: 限流规则持久化到 Nacos (dataId 里是 GatewayFlowRule 的 JSON 数组)
      datasource:
        gw-flow:
          nacos:
            server-addr: ${NACOS_ADDR:127.0.0.1:8848}
            data-id: mini-mall-gateway-gw-flow-rules
            group-id: SENTINEL_GROUP
            data-type: json
            rule-type: gw-flow

    gateway:
      routes:
        - id: user-route
          uri: lb://mini-mall-user
          predicates:
            - Path=/user/**

        - id: product-route
          uri: lb://mini-mall-product
          predicates:
            - Path=/product/**

        - id: category-route
          uri: lb://mini-mall-product
          predicates:
            - Path=/category/**

        - id: favorite-route
          uri: lb://mini-mall-product
          predicates:
            - Path=/favorite/**

        - id: cart-route
          uri: lb://mini-mall-order
          predicates:
            - Path=/cart/**

        - id: order-route
          uri: lb://mini-mall-order
          predicates:
            - Path=/order/**

        - id: seckill-route
          uri: lb://mini-mall-order
          predicates:
            - Path=/seckill/**

        - id: review-route
          uri: lb://mini-mall-review
          predicates:
            - Path=/review/**

        - id: coupon-route
          uri: lb://mini-mall-user
          predicates:
            - Path=/coupon/**

        - id: search-route
          uri: lb://mini-mall-search
          predicates:
            - Path=/search/**

        - id: auth-route
          uri: lb://mini-mall-auth
          predicates:
            - Path=/auth/**

        - id: admin-user-route
          uri: lb://mini-mall-user
          predicates:
            - Path=/admin/user/**

        - id: admin-product-route
          uri: lb://mini-mall-product
          predicates:
            - Path=/admin/product/**

        - id: admin-order-route
          uri: lb://mini-mall-order
          predicates:
            - Path=/admin/order/**
        # ⭐ 退款改造新增: 客服退款审批 → payment 服务 (挂 /admin/ 前缀强制 role=1)
        - id: admin-refund-route
          uri: lb://mini-mall-payment
          predicates:
            - Path=/admin/refund/**

        - id: file-route
          uri: lb://mini-mall-file
          predicates:
            - Path=/file/**

        - id: payment-route
          uri: lb://mini-mall-payment
          predicates:
            - Path=/pay/**,/refund/**

        # ─── AI 阶段新增: AI 客服 (9009) ──────────────
        # /ai/chat 是 C 端登录用户对话; 不在 WHITE_LIST(要 JWT), 命中 isCEndWrite(不要 admin)
        - id: ai-route
          uri: lb://mini-mall-ai
          predicates:
            - Path=/ai/**

logging:
  level:
    org.springframework.cloud.gateway: info
    reactor.netty.http.client: info

jwt:
  # 生产环境必须通过环境变量传入，且与 auth/user 等签发/校验 token 的服务保持一致。
  secret: ${JWT_SECRET}
