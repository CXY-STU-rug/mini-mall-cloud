<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ═══════════════════════════════════════════════════════════
         继承父 pom：拿 Spring Boot 3.3.5 + 全部版本锁
         ═══════════════════════════════════════════════════════════ -->
    <parent>
        <groupId>com.minimall</groupId>
        <artifactId>mini-mall-cloud</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>mini-mall-gateway</artifactId>
    <name>mini-mall-gateway</name>
    <description>网关：统一入口 + JWT 鉴权 + 路由转发</description>

    <dependencies>

        <!-- ⭐ ① Spring Cloud Gateway 核心
             这一个就会拉来 WebFlux + Netty + Reactor 全家桶
             所以【千万别再引 spring-boot-starter-web】，会跟 Servlet 冲突 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- ⭐ 阶段二: 响应式 Spring Security
             gateway 是 WebFlux, 引这个 starter 后 Spring Boot 自动装配【响应式】安全
             (ServerHttpSecurity / SecurityWebFilterChain), 由它接管 JWT 认证 + 授权,
             替代原来手写的 AuthGlobalFilter。版本由父 pom 管理, 不写 <version>。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ② 复用公共模块：Result / BusinessException 等 -->
        <dependency>
            <groupId>com.minimall</groupId>
            <artifactId>mini-mall-common-core</artifactId>
        </dependency>
        <!-- ⭐ common-security: 复用 JwtUtil(网关解 token) -->
        <!--    common-security 里 WebMvcConfig 加了 @ConditionalOnClass, gateway 是 WebFlux 不会冲突 -->
        <dependency>
            <groupId>com.minimall</groupId>
            <artifactId>mini-mall-common-security</artifactId>
        </dependency>

        <!-- ⭐ F2.7 新增：Sentinel Gateway 适配器
             - 普通 sentinel 是 MVC + Servlet 风格 (user/product 用的)
             - Gateway 是 WebFlux + Netty, 需要专门的 adapter
             - 它会自动把每条路由识别为 Sentinel 资源, 资源名 = 路由 ID -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-alibaba-sentinel-gateway</artifactId>
        </dependency>

        <!-- ⭐ G4 新增：Sentinel 规则持久化 (Nacos 数据源)
             - 没有它: 规则只在控制台内存里, 控制台/网关一重启全丢
             - 有了它: 网关启动时从 Nacos 拉规则并【订阅变更】, 改 Nacos 配置秒级生效
             - 数据流向是单向的: Nacos → 网关 (控制台里改的不会写回 Nacos, 规则以 Nacos 为准)
             - 版本由 spring-cloud-alibaba-dependencies BOM 管理, 不用写 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <!-- ⭐ 登出黑名单校验: 网关是 WebFlux, 必须用 reactive 版 Redis (ReactiveStringRedisTemplate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- ⭐ Knife4j 网关聚合 (WebFlux 版):
             - 业务服务引的是 mini-mall-common-swagger (各自生成 /v3/api-docs)
             - 网关只引这个聚合 starter: 从 Nacos 发现各服务, 汇总到 9080/doc.html 一个入口
             - 版本由父 pom dependencyManagement 锁的 knife4j.version(4.5.0) 决定 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-gateway-spring-boot-starter</artifactId>
        </dependency>

    </dependencies>

    <!-- ═══════════════════════════════════════════════════════════
         打 fat jar：跟 user/product 一样
         父 pom 在 pluginManagement 锁了配置，子模块只需要声明引用
         ═══════════════════════════════════════════════════════════ -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
